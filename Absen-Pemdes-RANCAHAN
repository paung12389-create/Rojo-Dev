<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- Pengaturan Full-Screen Native untuk Android & iOS -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f172a">
    <title>SIMPD - Portal HR Desa Terpadu</title>

    <style>
        /* Reset margin & kunci tinggi layar dinamis agar tidak ada scrollbar ganda */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            background-color: #0f172a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            overscroll-behavior: none;
        }

        /* Container utama layar penuh */
        .app-wrapper {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            background-color: #f8fafc;
        }

        /* Iframe pembungkus Web App Google Apps Script */
        #gas-frame {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            flex: 1;
        }

        /* Layar pemuatan (Loading Screen) elegan saat aplikasi dimuat */
        #loader-overlay {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 24px;
            text-align: center;
            transition: opacity 0.45s ease, visibility 0.45s ease;
        }

        #loader-overlay.fade-out {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .spinner {
            width: 46px;
            height: 46px;
            border: 4px solid rgba(255, 255, 255, 0.15);
            border-top-color: #6366f1;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin-bottom: 18px;
        }

        .loader-title {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.3px;
            margin-bottom: 6px;
        }

        .loader-sub {
            font-size: 12px;
            color: #94a3b8;
            max-width: 320px;
            line-height: 1.5;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <!-- Layar Loading Awal -->
    <div id="loader-overlay">
        <div class="spinner" id="loader-spinner"></div>
        <div class="loader-title" id="loader-title">Memuat Portal HR Desa...</div>
        <div class="loader-sub" id="loader-sub">Menghubungkan ke server terpadu secara aman</div>
    </div>

    <!-- Bingkai Utama Aplikasi (Tanpa Banner Peringatan GAS) -->
    <div class="app-wrapper">
        <iframe
            id="gas-frame"
            title="SIMPD - Portal HR Desa Terpadu"
            allow="geolocation *; camera *; microphone *; fullscreen *; clipboard-read *; clipboard-write *"
            allowfullscreen>
        </iframe>
    </div>

    <script>
        /**
         * KONFIGURASI URL WEB APP GOOGLE APPS SCRIPT
         * Ganti teks di bawah ini dengan URL Deployment Web App Anda (yang berakhiran /exec)
         */
        const GAS_WEB_APP_URL = "https://script.google.com/macros/s/AKfycbw_73IOPTHtxAx0RDaSE1wnrbdcqm2atOMSfaOu-H4olh8Gxx-LXpBeueU4J2GemVU/exec";

        (function initPortalWrapper() {
            const frame = document.getElementById("gas-frame");
            const loader = document.getElementById("loader-overlay");
            const titleEl = document.getElementById("loader-title");
            const subEl = document.getElementById("loader-sub");
            const spinnerEl = document.getElementById("loader-spinner");

            // Validasi apakah URL sudah diganti oleh admin
            if (!GAS_WEB_APP_URL || GAS_WEB_APP_URL.includes("AKfycbw_73IOPTHtxAx0RDaSE1wnrbdcqm2atOMSfaOu-H4olh8Gxx-LXpBeueU4J2GemVU")) {
                spinnerEl.style.display = "none";
                titleEl.textContent = "Konfigurasi URL Diperlukan";
                subEl.textContent = "Silakan buka file portal.html dan masukkan URL Web App Google Apps Script (/exec) Anda pada variabel GAS_WEB_APP_URL.";
                return;
            }

            // Pasang URL ke iframe
            frame.src = GAS_WEB_APP_URL;

            // Sembunyikan layar loading setelah Web App selesai dimuat
            frame.addEventListener("load", function () {
                setTimeout(function () {
                    loader.classList.add("fade-out");
                }, 300);
            });

            // Pengaman timeout jika jaringan lambat (maksimal 8 detik)
            setTimeout(function () {
                loader.classList.add("fade-out");
            }, 8000);
        })();
    </script>
</body>
</html>
